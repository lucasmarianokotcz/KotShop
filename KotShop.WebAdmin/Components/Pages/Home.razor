@page "/"
@attribute [Authorize(Policy = AdminAccess.Policy)]

<PageTitle>Visão geral | KotShop Admin</PageTitle>
<p class="text-sm font-semibold uppercase tracking-wider text-indigo-600">Painel administrativo</p>
<h1 class="mt-2 text-3xl font-bold">Bem-vindo ao KotShop Admin</h1>
<p class="mt-3 text-slate-600">Acompanhe o catálogo da sua loja em um só lugar.</p>
<section class="mt-8 max-w-xl rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <h2 class="text-xl font-semibold">Catálogo de produtos</h2>
    <p class="mt-2 text-slate-600">Consulte os produtos, as categorias e os preços cadastrados.</p>
    <a href="produtos" class="mt-5 inline-block rounded-lg bg-indigo-600 px-5 py-3 font-medium text-white hover:bg-indigo-700">Consultar produtos</a>
</section>
