@page "/produtos"
@attribute [Authorize(Policy = AdminAccess.Policy)]
@using System.Globalization
@using KotShop.Application.Produtos.ConsultarCatalogo
@inject ICatalogoService Catalogo

<PageTitle>Produtos | KotShop Admin</PageTitle>
<h1 class="text-3xl font-bold">Produtos</h1>
<p class="mt-2 text-slate-600">Consulta do catálogo da loja.</p>
@if (falhou)
{
    <p role="alert" class="mt-6 rounded-lg bg-red-50 p-4 text-red-800">Não foi possível carregar o catálogo. Tente novamente em instantes.</p>
}
else if (produtos.Count == 0)
{
    <p class="mt-6 rounded-lg border border-slate-200 bg-white p-6">Nenhum produto cadastrado.</p>
}
else
{
    <div class="mt-6 overflow-x-auto rounded-xl border border-slate-200 bg-white">
        <table class="w-full text-left text-sm">
            <caption class="sr-only">Produtos cadastrados na loja</caption>
            <thead class="bg-slate-100 text-slate-600"><tr><th scope="col" class="p-4">Código</th><th scope="col" class="p-4">Produto</th><th scope="col" class="p-4">Categoria</th><th scope="col" class="p-4 text-right">Preço base</th></tr></thead>
            <tbody>
                @foreach (var produto in produtos)
                {
                    <tr class="border-t border-slate-100"><td class="p-4 text-slate-500">@produto.Id</td><th scope="row" class="p-4 font-medium">@produto.Nome</th><td class="p-4">@produto.Categoria</td><td class="p-4 text-right">@produto.Preco.ToString("C", CultureInfo.GetCultureInfo("pt-BR"))</td></tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private IReadOnlyList<ProdutoResumo> produtos = [];
    private bool falhou;
    [Inject] private ILogger<Produtos> Logger { get; set; } = default!;
    protected override async Task OnInitializedAsync()
    {
        try { produtos = await Catalogo.ListarAsync(); }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Falha ao consultar catálogo administrativo.");
            falhou = true;
        }
    }
}
