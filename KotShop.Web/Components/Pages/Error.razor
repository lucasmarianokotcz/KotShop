@page "/Error"
@using System.Diagnostics

<TituloPagina Nome="Erro" />

<h1 class="text-danger">Erro.</h1>
<h2 class="text-danger">Ocorreu um erro ao processar sua requisição.</h2>

@if (ShowRequestId)
{
    <p>
        <strong>Código da Requisição:</strong> <code>@RequestId</code>
    </p>
}

<h3>Modo Desenvolvimento</h3>
<p>
    Mudar para o ambiente de <strong>Desenvolvimento</strong> vai mostrar informações mais detalhadas sobre o erro.
</p>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
