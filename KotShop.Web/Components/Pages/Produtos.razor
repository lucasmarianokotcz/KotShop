@page "/produtos"
@using KotShop.Application.Categorias
@using KotShop.Application.Catalogo.Consultar
@using KotShop.Application.Produtos.ConsultarCatalogo
@using KotShop.Web.Features.Produtos
@inject ICatalogoService Catalogo

<TituloPagina Nome="Produtos" />

<div class="mb-8 flex items-center gap-3">
    <span class="h-8 w-1.5 rounded-full bg-emerald-600" aria-hidden="true"></span>
    <h1 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">@Titulo</h1>
</div>
<ListaProdutos Produtos="ProdutosVisiveis" />

@code {
    private IReadOnlyList<ProdutoResumo> produtos = [];

    [SupplyParameterFromQuery(Name = "categoria")]
    public string? Categoria { get; set; }

    [CascadingParameter]
    public IReadOnlyList<CategoriaResumo> Categorias { get; set; } = [];

    private CategoriaResumo? CategoriaSelecionada => CategoriaSlug.Encontrar(Categorias, Categoria ?? string.Empty);

    private IReadOnlyList<ProdutoResumo> ProdutosVisiveis => Categoria is null
        ? produtos
        : CategoriaSelecionada is { } categoria
            ? produtos.Where(produto => produto.CategoriaId == categoria.Id).ToList()
            : [];

    private string Titulo
    {
        get
        {
            string? categoria = CategoriaSelecionada?.Nome ?? Categoria;
            return string.IsNullOrEmpty(categoria) ? "Produtos" : $"{categoria}";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        produtos = await Catalogo.ListarProdutosAsync();
    }
}
