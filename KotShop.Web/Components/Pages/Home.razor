@page "/"

@using Flowbite.Components
@using KotShop.Web.Data
@using KotShop.Web.Data.ViewModels.Produto
@using Microsoft.EntityFrameworkCore

@inject IDbContextFactory<DataContext> DbFactory

<TituloPagina Nome="Início" />

<main>
    <section aria-labelledby="titulo-produtos">
        @if (produtos.Count == 0)
        {
            <Card>
                <p class="text-slate-600">Nenhum produto disponível.</p>
            </Card>
        }
        else
        {
            <ul class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
                @foreach (var produto in produtos)
                {
                    <li>
                        <Card Class="h-full max-w-none">
                            <article class="flex h-full flex-col gap-5 p-6">
                                <div>
                                    <p class="text-sm text-slate-500">@produto.Categoria</p>
                                    <h2 class="mt-1 text-xl font-bold text-slate-900">@produto.Nome</h2>
                                </div>
                                <div>
                                    <p class="mt-3 text-3xl font-bold tracking-tight text-slate-900">@produto.PrecoAVista</p>
                                    <p class="text-sm text-slate-600">à vista no Pix <span class="inline-block rounded-full bg-emerald-50 px-1 py-1 text-xs font-semibold text-emerald-800">@(ProdutoViewModel.DescontoAVistaEmPorcentagem)% off</span></p>
                                </div>
                                <div class="mt-auto border-t border-slate-100 pt-4 text-sm text-slate-600">
                                    <p>Ou <strong class="font-semibold text-slate-900">@(ProdutoViewModel.MaximoDeParcelas)x de @produto.PrecoParcela</strong> nos cartões</p>
                                    <p class="mt-1">Total: @produto.PrecoTotalAPrazo</p>
                                </div>
                            </article>
                        </Card>
                    </li>
                }
            </ul>
        }
    </section>
</main>

@code {
    private List<ProdutoViewModel> produtos = [];

    protected override async Task OnInitializedAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();

        produtos = await context.Produtos
            .AsNoTracking()
            .Select(p => new ProdutoViewModel(
                p.Id,
                p.Nome,
                p.Preco,
                p.Categoria.Nome))
            .ToListAsync();
    }
}
