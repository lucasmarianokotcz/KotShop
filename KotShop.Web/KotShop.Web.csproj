<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>aspnet-KotShop_Web-6f053550-6de6-4aca-a5d3-9fb00d03ad5f</UserSecretsId>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Flowbite" Version="0.2.6-beta" />
    <PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" PrivateAssets="all" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../KotShop.Application/KotShop.Application.csproj" />
    <ProjectReference Include="../KotShop.Data/KotShop.Data.csproj" />
    <ProjectReference Include="../KotShop.Infrastructure/KotShop.Infrastructure.csproj" />
  </ItemGroup>

  <Target Name="BuildTailwind" BeforeTargets="BeforeBuild" Condition="'$(SkipTailwind)' != 'true'">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)/node_modules/@tailwindcss/cli')" Text="Instale as dependências de CSS: execute npm ci na pasta KotShop.Web." />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)" Command="npm run css:build" />
  </Target>

</Project>
